pipeline {
    agent any

    tools {
        nodejs 'NodeJS' // Matches the Node plugin configured in Jenkins
    }

    environment {
        REPO_URL = 'https://github.com/madhuramhatre/Onity-Design-System.git'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                // Checks if package.json exists before running npm install
                bat '''
                    if exist package.json (
                        npm install
                    ) else (
                        echo No package.json found. Skipping npm install step.
                    )
                '''
            }
        }

        stage('Build Design Tokens & Storybook') {
            steps {
                bat 'npm run build-storybook'
            }
        }

    stage('Deploy to GitHub Pages') {
            steps {
                bat '''
                    git config --global core.longpaths true
                    cd storybook-static
                    git init
                    git config user.name "Jenkins CI"
                    git config user.email "jenkins@onity.com"
                    git checkout -b gh-pages
                    git add .
                    git commit -m "Deploy Storybook to GitHub Pages [skip ci]"
                    git push --force https://github.com/madhuramhatre/Onity-Design-System.git gh-pages
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully! Onity Design System is live and updated.'
        }
        failure {
            echo 'Pipeline failed. Please check the build logs in Jenkins.'
        }
    }
}
